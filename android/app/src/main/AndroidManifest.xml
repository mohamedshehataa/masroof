<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature
        android:name="android.hardware.telephony"
        android:required="false" />

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Normal (install-time) permission: only to show "offline" on the login screen and disable Sign in. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Dangerous (runtime) permission, requested from Settings only when the user turns SMS capture on. The app works
         fully without it; READ_SMS (history backfill) is added with that feature. -->
    <uses-permission android:name="android.permission.RECEIVE_SMS" />

    <application
        android:name=".MasroofApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Masroof">

        <!-- Reason: this is the launcher activity (MAIN/LAUNCHER); it must be exported to be startable. It takes
             no extras, reads no intent data and is the only exported component. -->
        <!-- nosemgrep: java.android.security.exported_activity.exported_activity -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Reason: the system delivers SMS_RECEIVED from outside the app, so the receiver must be exported; the
             BROADCAST_SMS permission means only the system can send it. It does no work itself (hands off to WorkManager). -->
        <!-- nosemgrep: java.android.security.exported_activity.exported_activity -->
        <receiver
            android:name=".ingest.SmsReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter>
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>

        <!-- WorkManager is initialised by MasroofApp (Hilt worker factory), not by the default startup provider. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
    </application>
</manifest>
