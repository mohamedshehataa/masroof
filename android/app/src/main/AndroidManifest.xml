<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature
        android:name="android.hardware.telephony"
        android:required="false" />

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Normal (install-time) permission: only to show "offline" on the login screen and disable Sign in. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Dangerous (runtime) permission, requested from Settings only when the user turns SMS capture on. The app works
         fully without it; READ_SMS (history backfill) is added with that feature. -->
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <!-- Runtime permission (Android 13+), requested from Settings only when the user turns on the "Recorded ... Undo"
         notification for transactions the phone captured by itself. The app works fully without it. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".MasroofApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Masroof">

        <!-- Reason: this is the launcher activity (MAIN/LAUNCHER); it must be exported to be startable. It takes
             no extras, reads no intent data and is the only exported component. -->
        <!-- nosemgrep: java.android.security.exported_activity.exported_activity -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Reason: the system delivers SMS_RECEIVED from outside the app, so the receiver must be exported; the
             BROADCAST_SMS permission means only the system can send it. It does no work itself (hands off to WorkManager). -->
        <!-- nosemgrep: java.android.security.exported_activity.exported_activity -->
        <receiver
            android:name=".ingest.SmsReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter>
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>

        <!-- The buttons of the "Recorded ... Undo" notification. Not exported: only this app can send these broadcasts. -->
        <receiver
            android:name=".ingest.CapturedActionReceiver"
            android:exported="false" />

        <!-- Reason: the system binds the listener from outside the app, so it must be exported; BIND_NOTIFICATION_
             LISTENER_SERVICE means only the system can bind it. It only hands allowlisted notification text to
             WorkManager (REQ-NTF-001); the user must grant "Notification access" in system settings. -->
        <!-- nosemgrep: java.android.security.exported_service.exported_service -->
        <service
            android:name=".ingest.MasroofNotificationListener"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- The system camera writes a receipt photo into the app cache through this provider (TakePicture needs no CAMERA
             permission as long as the manifest does not declare it). Not exported; only the cache subfolder "receipts/" is shared,
             and access is granted per intent. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.receipts"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/receipt_paths" />
        </provider>

        <!-- WorkManager is initialised by MasroofApp (Hilt worker factory), not by the default startup provider. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
    </application>
</manifest>
