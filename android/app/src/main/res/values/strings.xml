    <string name="sms_title">Capture bank SMS</string>
    <string name="sms_rationale">Masroof reads a message from your bank or wallet on this phone, works out the amount and who was paid, and sends only that: no message text ever leaves the phone. Only listed senders are read, one-time passwords are dropped, and the app works fully without this permission.</string>
    <string name="sms_enable">Turn on SMS capture</string>
    <string name="sms_on">SMS capture is on</string>
    <string name="sms_denied">Permission not granted. You can still add expenses by hand.</string>
    <string name="sms_suggested_title">Suggested senders</string>
    <string name="sms_suggested_body">These senders sent a message that looks like a payment. Nothing was stored. Add one to start capturing it.</string>
    <string name="sms_add_sender">Add</string>
    <string name="ntf_title">Capture InstaPay and bank-app notifications</string>
    <string name="ntf_rationale">Masroof can read notifications from the InstaPay app and other bank apps you list, on this phone only, and send just the amount and who was paid. It needs the system setting \"Notification access\", which you can switch off at any time. The app works fully without it.</string>
    <string name="ntf_enable">Turn on notification capture</string>
    <string name="ntf_open_settings">Open notification access settings</string>
    <string name="ntf_on">Notification capture is on</string>
    <string name="ntf_needs_access">Also allow Masroof under Notification access in system settings.</string>
    <string name="ntf_disable">Turn off</string>
