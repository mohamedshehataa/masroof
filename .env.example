# Masroof — environment variables. Copy to .env and fill in. Never commit .env.
# Every variable the system reads is listed here with a comment.

# ---------- Core ----------
APP_ENV=local                         # local | staging | prod
APP_BASE_URL=http://localhost:8080    # public URL of the backend (HTTPS in staging/prod)
WEB_BASE_URL=http://localhost:5173    # public URL of the PWA
APP_TIMEZONE=Africa/Cairo             # household timezone for all business dates
APP_ENCRYPTION_KEY=changeme-32-bytes-base64   # AES-GCM key for sensitive columns (generate: openssl rand -base64 32)

# ---------- Database ----------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=masroof
POSTGRES_USER=masroof
POSTGRES_PASSWORD=changeme

# ---------- Object storage (S3-compatible; MinIO locally) ----------
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=masroof-media
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# ---------- Auth ----------
JWT_SECRET=changeme-generate-with-openssl-rand-base64-48
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ---------- AI (Anthropic) ----------
ANTHROPIC_API_KEY=                    # TODO(owner): required for parsing + evals with the real API
AI_MODEL_FAST=claude-haiku-5-5        # classification / cheap extraction
AI_MODEL_STRONG=claude-sonnet-5-5     # receipts (vision) and hard cases
AI_MODEL_JUDGE=claude-opus-5-5        # LLM-as-judge for narrative evals (must differ from the generator)
AI_MONTHLY_BUDGET_USD=20              # product-side AI spend alert threshold
AI_AMOUNT_CEILING_EGP=50000           # parsed amounts above this are forced to PENDING_REVIEW

# ---------- Speech-to-text ----------
STT_PROVIDER=openai                   # openai | faster-whisper | none
OPENAI_API_KEY=                       # TODO(owner): only if STT_PROVIDER=openai
STT_BASE_URL=http://faster-whisper:8000   # only if STT_PROVIDER=faster-whisper

# ---------- WhatsApp Cloud API ----------
WHATSAPP_MODE=group                   # group | direct
WHATSAPP_PHONE_NUMBER_ID=             # TODO(owner)
WHATSAPP_BUSINESS_ACCOUNT_ID=         # TODO(owner)
WHATSAPP_ACCESS_TOKEN=                # TODO(owner): permanent system-user token
WHATSAPP_APP_SECRET=                  # TODO(owner): used to verify X-Hub-Signature-256
WHATSAPP_VERIFY_TOKEN=changeme-random-string   # used in the GET webhook handshake
WHATSAPP_GROUP_ID=                    # filled by the bot after it creates the group
MEMBER1_PHONE_E164=                   # TODO(owner): Mohamed, e.g. +2010xxxxxxxx
MEMBER2_PHONE_E164=                   # TODO(owner)

# ---------- Push ----------
FCM_SERVICE_ACCOUNT_JSON_PATH=        # TODO(owner): path to the Firebase service-account JSON (Android push)
WEB_PUSH_VAPID_PUBLIC_KEY=            # generate with: npx web-push generate-vapid-keys
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:admin@example.com

# ---------- FX rates ----------
FX_PROVIDER=frankfurter               # frankfurter (free, no key) | exchangerate_host
FX_API_KEY=

# ---------- Observability ----------
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
SENTRY_DSN=                           # TODO(owner): GlitchTip/Sentry DSN (optional)
LOG_LEVEL=INFO

# ---------- Deploy (infra) ----------
DOMAIN=                               # TODO(owner): e.g. masroof.example.com (Caddy issues HTTPS)
ACME_EMAIL=                           # for Let's Encrypt
PROD_HOST=                            # TODO(owner): ssh host of the production VPS; guard-bash.sh blocks commands to it outside /release
STAGING_HOST=
BACKUP_ENCRYPTION_PASSPHRASE=changeme # age/gpg passphrase for nightly backups
BACKUP_S3_BUCKET=

# ---------- SDLC budgets (read by hooks and skills) ----------
SDLC_AI_BUDGET_USD=300                # budget-check.sh warns when docs/SDLC_METRICS.md spend exceeds this
INFRA_BUDGET_USD=30
