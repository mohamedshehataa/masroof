{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read", "Edit", "Write", "Glob", "Grep",
      "Bash(make *)", "Bash(make)",
      "Bash(./gradlew *)", "Bash(cd backend && ./gradlew *)", "Bash(cd android && ./gradlew *)",
      "Bash(npm run *)", "Bash(npm test*)", "Bash(npm ci*)", "Bash(npm install*)", "Bash(cd web && npm *)",
      "Bash(npx playwright *)", "Bash(npx prettier *)", "Bash(npx eslint *)", "Bash(npx vitest *)", "Bash(npx tsc *)", "Bash(npx @redocly/cli*)", "Bash(npx lefthook *)",
      "Bash(docker compose *)", "Bash(docker build *)", "Bash(docker ps*)", "Bash(docker logs *)", "Bash(docker images*)", "Bash(docker run --rm *)",
      "Bash(git status*)", "Bash(git diff*)", "Bash(git log*)", "Bash(git show*)", "Bash(git add *)", "Bash(git commit *)",
      "Bash(git switch *)", "Bash(git checkout -b *)", "Bash(git worktree *)", "Bash(git rebase *)", "Bash(git merge *)",
      "Bash(git branch*)", "Bash(git fetch*)", "Bash(git stash*)", "Bash(git rev-parse*)", "Bash(git ls-files*)", "Bash(git tag*)",
      "Bash(git push origin story/*)", "Bash(git push -u origin story/*)",
      "Bash(gh pr *)", "Bash(gh issue *)", "Bash(gh run *)", "Bash(gh repo view*)", "Bash(gh api *)",
      "Bash(psql -h localhost *)", "Bash(psql postgresql://*@localhost*)",
      "Bash(semgrep *)", "Bash(trivy *)", "Bash(gitleaks *)", "Bash(osv-scanner *)", "Bash(shellcheck *)",
      "Bash(python *)", "Bash(python3 *)", "Bash(jq *)", "Bash(bash scripts/*)", "Bash(bash .claude/hooks/tests/*)", "Bash(source scripts/env.sh *)", "Bash(. scripts/env.sh *)",
      "Bash(ls*)", "Bash(cat *)", "Bash(grep *)", "Bash(rg *)", "Bash(find *)", "Bash(head *)", "Bash(tail *)", "Bash(wc *)", "Bash(diff *)", "Bash(sort *)",
      "Bash(mkdir *)", "Bash(cp *)", "Bash(mv *)", "Bash(touch *)", "Bash(chmod +x *)",
      "Bash(curl -s http://localhost*)", "Bash(curl http://localhost*)", "Bash(curl -fsS http://localhost*)",
      "Bash(adb *)", "Bash(maestro *)", "Bash(k6 *)", "Bash(lhci *)"
    ],
    "ask": [
      "Bash(git push *)", "Bash(gh repo create *)", "Bash(gh release *)", "Bash(docker compose down -v*)", "Bash(npm publish*)"
    ],
    "deny": [
      "Bash(git push --force*)", "Bash(git push -f *)", "Bash(git push * --force*)", "Bash(git push * -f *)", "Bash(git push --force-with-lease*)", "Bash(git push * --delete main*)",
      "Bash(git commit * --no-verify*)", "Bash(git commit --no-verify*)", "Bash(git push * --no-verify*)",
      "Bash(rm -rf /*)", "Bash(rm -rf ~*)", "Bash(rm -rf .git*)", "Bash(rm -rf ..*)",
      "Bash(curl * | sh*)", "Bash(curl * | bash*)", "Bash(wget * | sh*)", "Bash(wget * | bash*)",
      "Bash(ssh *)", "Bash(scp *)", "Bash(sftp *)", "Bash(sudo *)", "Bash(chmod 777 *)", "Bash(chmod -R 777 *)",
      "Bash(docker system prune -a*)", "Bash(docker volume prune*)", "Bash(docker volume rm *)",
      "Bash(printenv)", "Bash(env)", "Bash(cat .env)", "Bash(cat ./.env)",
      "Read(.env)", "Read(.env.local)", "Read(.env.prod)", "Read(.env.production)", "Read(.env.staging)", "Read(.env.development)", "Read(.env.test)",
      "Read(**/*.jks)", "Read(**/*.keystore)", "Read(**/*.p12)", "Read(**/*.pfx)", "Read(./secrets/**)", "Read(**/secrets/**)",
      "WebFetch(domain:pastebin.com)"
    ]
  },
  "env": {
    "MASROOF_SDLC": "1"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-bash.sh", "timeout": 20 },
          { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/restore-protected.sh --snapshot", "timeout": 20 }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/protect-files.sh", "timeout": 20 },
          { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/scan-secrets.sh", "timeout": 20 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format-changed.sh", "timeout": 120 },
          { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/test-integrity.sh", "timeout": 30 }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/restore-protected.sh", "timeout": 30 }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/restore-protected.sh", "timeout": 30 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/stop-gate.sh", "timeout": 600 }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/check-output-contract.sh", "timeout": 20 }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|compact|clear",
        "hooks": [
          { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/inject-context.sh", "timeout": 20 }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/snapshot-progress.sh", "timeout": 20 }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/budget-check.sh", "timeout": 15 }
        ]
      }
    ]
  }
}
