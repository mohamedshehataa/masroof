{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(. scripts/env.sh *)",
      "Bash(./gradlew *)",
      "Bash(adb *)",
      "Bash(bash .claude/hooks/tests/*)",
      "Bash(bash scripts/*)",
      "Bash(cat *)",
      "Bash(cd android && ./gradlew *)",
      "Bash(cd backend && ./gradlew *)",
      "Bash(cd web && npm *)",
      "Bash(chmod +x *)",
      "Bash(cp *)",
      "Bash(curl -fsS http://localhost*)",
      "Bash(curl -s http://localhost*)",
      "Bash(curl http://localhost*)",
      "Bash(diff *)",
      "Bash(docker build *)",
      "Bash(docker compose *)",
      "Bash(docker compose down -v*)",
      "Bash(docker images*)",
      "Bash(docker logs *)",
      "Bash(docker ps*)",
      "Bash(docker run --rm *)",
      "Bash(find *)",
      "Bash(gh api *)",
      "Bash(gh issue *)",
      "Bash(gh pr *)",
      "Bash(gh release *)",
      "Bash(gh repo create *)",
      "Bash(gh repo view*)",
      "Bash(gh run *)",
      "Bash(git add *)",
      "Bash(git branch*)",
      "Bash(git checkout -b *)",
      "Bash(git commit *)",
      "Bash(git diff*)",
      "Bash(git fetch*)",
      "Bash(git log*)",
      "Bash(git ls-files*)",
      "Bash(git merge *)",
      "Bash(git push *)",
      "Bash(git push -u origin story/*)",
      "Bash(git push origin story/*)",
      "Bash(git rebase *)",
      "Bash(git rev-parse*)",
      "Bash(git show*)",
      "Bash(git stash*)",
      "Bash(git status*)",
      "Bash(git switch *)",
      "Bash(git tag*)",
      "Bash(git worktree *)",
      "Bash(gitleaks *)",
      "Bash(grep *)",
      "Bash(head *)",
      "Bash(jq *)",
      "Bash(k6 *)",
      "Bash(lhci *)",
      "Bash(ls*)",
      "Bash(maestro *)",
      "Bash(make *)",
      "Bash(make)",
      "Bash(mkdir *)",
      "Bash(mv *)",
      "Bash(npm ci*)",
      "Bash(npm install*)",
      "Bash(npm run *)",
      "Bash(npm test*)",
      "Bash(npx @redocly/cli*)",
      "Bash(npx eslint *)",
      "Bash(npx lefthook *)",
      "Bash(npx playwright *)",
      "Bash(npx prettier *)",
      "Bash(npx tsc *)",
      "Bash(npx vitest *)",
      "Bash(osv-scanner *)",
      "Bash(psql -h localhost *)",
      "Bash(psql postgresql://*@localhost*)",
      "Bash(python *)",
      "Bash(python3 *)",
      "Bash(rg *)",
      "Bash(semgrep *)",
      "Bash(shellcheck *)",
      "Bash(sort *)",
      "Bash(source scripts/env.sh *)",
      "Bash(tail *)",
      "Bash(touch *)",
      "Bash(trivy *)",
      "Bash(wc *)",
      "Edit",
      "Glob",
      "Grep",
      "Read",
      "Write"
    ],
    "ask": [],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f *)",
      "Bash(git push * --force*)",
      "Bash(git push * -f *)",
      "Bash(git push --force-with-lease*)",
      "Bash(git push * --delete main*)",
      "Bash(git commit * --no-verify*)",
      "Bash(git commit --no-verify*)",
      "Bash(git push * --no-verify*)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)",
      "Bash(rm -rf .git*)",
      "Bash(rm -rf ..*)",
      "Bash(curl * | sh*)",
      "Bash(curl * | bash*)",
      "Bash(wget * | sh*)",
      "Bash(wget * | bash*)",
      "Bash(ssh *)",
      "Bash(scp *)",
      "Bash(sftp *)",
      "Bash(sudo *)",
      "Bash(chmod 777 *)",
      "Bash(chmod -R 777 *)",
      "Bash(docker system prune -a*)",
      "Bash(docker volume prune*)",
      "Bash(docker volume rm *)",
      "Bash(printenv)",
      "Bash(env)",
      "Bash(cat .env)",
      "Bash(cat ./.env)",
      "Read(.env)",
      "Read(.env.local)",
      "Read(.env.prod)",
      "Read(.env.production)",
      "Read(.env.staging)",
      "Read(.env.development)",
      "Read(.env.test)",
      "Read(**/*.jks)",
      "Read(**/*.keystore)",
      "Read(**/*.p12)",
      "Read(**/*.pfx)",
      "Read(./secrets/**)",
      "Read(**/secrets/**)",
      "WebFetch(domain:pastebin.com)"
    ],
    "defaultMode": "bypassPermissions"
  },
  "env": {
    "MASROOF_SDLC": "1"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-bash.sh",
            "timeout": 20
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/restore-protected.sh --snapshot",
            "timeout": 20
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/protect-files.sh",
            "timeout": 20
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/scan-secrets.sh",
            "timeout": 20
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format-changed.sh",
            "timeout": 120
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/test-integrity.sh",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/restore-protected.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/restore-protected.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/stop-gate.sh",
            "timeout": 600
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/check-output-contract.sh",
            "timeout": 20
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|compact|clear",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/inject-context.sh",
            "timeout": 20
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/snapshot-progress.sh",
            "timeout": 20
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/budget-check.sh",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
